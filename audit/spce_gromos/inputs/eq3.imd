TITLE
2048 SPCE water, eq3
benchmark protocol: dt 0.001 ps, cutoff 1.8 nm, EPSRF 61
END
SYSTEM
#      NPM      NSM
         0      2048
END
STEP
#   NSTLIM         T        DT
    100000       0.0     0.001
END
INITIALISE
#    NTIVEL   NTISHK   NTINHT    NTINHB    NTISHI  NTIRTC     NTICOM   NTISTI      IG     TEMPI
      0       0        0         0         0       0          0        0       770100     0.00
END
BOUNDCOND
#      NTB    NDFMIN
       1      6
END
FORCE
#      NTF array
# bonds    angles    imp.     dihe     charge nonbonded
# H        H         H        H
  1     1     1     1     1     1
# NEGR    NRE(1)
     1     6144
END
CONSTRAINT
#      NTC       NTCP   NTCP0(1)     NTCS      NTCS0(1)
         1          1    0.00001        1      0.00001
END
PAIRLIST
#    algorithm    NSNB    RCUTP    RCUTL    SIZE    TYPE
     1  5  1.8  1.8     0.4     0
END
NONBONDED
# RCRF and ASHAPE track the long-range cutoff: the reaction field is the continuum
# beyond the cutoff, so a radius disagreeing with RCUTL is an inconsistent
# electrostatic treatment.
# NLRELE    APPAK      RCRF     EPSRF  NSLFEXCL
       1      0.0       1.8          61     1
# NSHAPE   ASHAPE    NA2CLC   TOLA2   EPSLS
       -1       1.8        2   1e-10       0
# NKX    NKY   NKZ    KCUT
   10     10    10     100
# NGX   NGY   NGZ  NASORD  NFDORD   NALIAS  NSPORD
   32    32    32       3       2        3       4
# NQEVAL   FACCUR   NRDGRD   NWRGRD   NLRLJ    SLVDNS
  100000      1.6        0        0       0      33.3
END
PRINTOUT
#     NTPR          NTPP
        1000          0
END
COVALENTFORM
#    NTBBH    NTBAH     NTBDN
         0         0         0
END
COMTRANSROT
#   NSCM
    1000
END
MULTIBATH
# ALGORITHM: 0 = weak coupling
#  ALGORITHM
          0
#  NBATHS
   1
# TEMP0(1 ... NBATHS)  TAU(1 ... NBATHS)
      298.15000     0.10
#  DOFSET
   1
# LAST(1 ... DOFSET)  COMBATH(1 ... DOFSET)  IRBATH(1 ... DOFSET)
       6144        1        1
END
WRITETRAJ
#    NTWX     NTWSE      NTWV      NTWF      NTWE      NTWG      NTWB
      1000         0         0         0      1000         0         0
END
PRESSURESCALE
#    COUPLE:    off(0), calc(1), scale(2)
#    SCALE:  off(0), iso(1), aniso(2), full(3), semianiso(4)
#    VIRIAL: none(0), atomic(1), group(2)
# COUPLE   SCALE    COMP    TAUP  VIRIAL
        2       1 0.0004575    0.50       2
# SEMIANISOTROPIC COUPLINGS(X, Y, Z)
       1     1     1
# PRES0(1...3,1...3)  1 atm = 0.06102 kJ mol^-1 nm^-3
 0.06102       0       0
       0 0.06102       0
       0       0 0.06102
END
