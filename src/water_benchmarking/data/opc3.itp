; OPC3 -- Izadi & Onufriev, J. Chem. Phys. 145:074501 (2016), doi:10.1063/1.4960175
;
; Self-contained on purpose.  The parameters below are those GROMACS 2026.1 ships
; in amber19sb.ff (opc3.itp and ffnonbonded.itp), but that file cannot be included
; here: amber19sb.ff declares comb-rule 2 (sigma/epsilon) with gen-pairs and
; fudgeQQ 0.8333, while this benchmark builds every topology on top of
; gromos54a7.ff, which declares comb-rule 1 (C6/C12) with no fudge.  Mixing the two
; sets of [ defaults ] is what grompp refuses.  For a box of nothing but water
; there is a single interacting pair, so the two forms are exactly equivalent and
; the parameters are simply restated in the C6/C12 the rest of the topology uses.
;
; One side effect: gromos54a7.ff/forcefield.itp sets _FF_GROMOS96, so grompp emits
; its twin-range parametrisation warning against this topology too, even though
; OPC3 is not a GROMOS model.  It is the third of the three warnings the run script
; already passes -maxwarn 3 for, and this protocol runs single-range on purpose.
;
;   sigma_O   = 0.317427035094 nm       C6  = 4 eps sigma^6  = 2.7975840421e-03
;   eps_O     = 0.683690704000 kJ/mol   C12 = 4 eps sigma^12 = 2.8618483573e-06
;   q_O/q_H   = -0.895170 / +0.447585 e
;   r_OH      = 0.09788820 nm,  r_HH = 0.15985070 nm  (theta = 109.47 deg)
;
; tests/test_models.py re-derives C6 and C12 from sigma and eps and fails if this
; file drifts from them.  Hydrogen carries no Lennard-Jones term.
;
; Oxygen mass is 15.99940, not the 16.00000 of the amber file: it is the value
; box.MASSES uses for the centre of mass and the density assertion, and a 0.004%
; disagreement between the box builder and the topology has no upside.

[ atomtypes ]
;  name   at.num    mass     charge  ptype           c6              c12
  OW_opc3      8   15.99940   0.000      A   2.7975840421e-03   2.8618483573e-06
  HW_opc3      1    1.00800   0.000      A   0.0000000000e+00   0.0000000000e+00

[ moleculetype ]
; molname   nrexcl
SOL         2

[ atoms ]
;   nr      type  resnr  residue   atom   cgnr      charge      mass
     1   OW_opc3      1      SOL     OW      1   -0.895170   15.99940
     2   HW_opc3      1      SOL    HW1      1    0.447585    1.00800
     3   HW_opc3      1      SOL    HW2      1    0.447585    1.00800

#ifndef FLEXIBLE
[ settles ]
; OW    funct        doh          dhh
1           1   0.09788820   0.15985070

[ exclusions ]
1   2   3
2   1   3
3   1   2
#else
; Never used by this benchmark -- the protocol is rigid water throughout (SETTLE
; here, SHAKE in GROMOS).  Kept so the file is a drop-in for the amber one; the
; force constants are amber19sb's.
[ bonds ]
; i   j   funct     length   force_constant
1     2       1   0.09788820   462750.4   0.09788820   462750.4
1     3       1   0.09788820   462750.4   0.09788820   462750.4

[ angles ]
; i   j   k   funct    angle   force_constant
2     1   3       1   109.47      836.8      109.47      836.8
#endif
